{
  "expo": {
    "name": "Lumen: Daily Prayer & Bible",
    "slug": "lumen-daily-prayer",
    "version": "1.0.0",
    "orientation": "default",
    "scheme": "lumen",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "com.lumen.dailyprayer",
      "supportsTablet": true,
      "icon": "./assets/icon.png",
      "infoPlist": {
        "UIBackgroundModes": ["audio"]
      }
    },
    "android": {
      "package": "com.lumen.dailyprayer",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0E1220"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "backgroundColor": "#0E1220",
          "imageWidth": 200
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#D9A441"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
