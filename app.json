{
  "expo": {
    "name": "Selaora: Daily Prayer & Bible",
    "slug": "lumen-daily-prayer",
    "version": "1.1.0",
    "orientation": "default",
    "scheme": [
      "selaora",
      "lumen"
    ],
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "com.lumen.dailyprayer",
      "supportsTablet": true,
      "icon": "./assets/icon.png"
    },
    "android": {
      "package": "com.lumen.dailyprayer",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0E1220"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/ionicons.ttf",
            "./node_modules/@expo-google-fonts/fraunces/Fraunces_400Regular.ttf",
            "./node_modules/@expo-google-fonts/fraunces/Fraunces_600SemiBold.ttf",
            "./node_modules/@expo-google-fonts/figtree/Figtree_400Regular.ttf",
            "./node_modules/@expo-google-fonts/figtree/Figtree_500Medium.ttf",
            "./node_modules/@expo-google-fonts/figtree/Figtree_600SemiBold.ttf",
            "./node_modules/@expo-google-fonts/figtree/Figtree_700Bold.ttf"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "backgroundColor": "#0E1220",
          "imageWidth": 200
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#D9A441"
        }
      ],
      "expo-asset",
      "expo-localization",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
