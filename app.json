{
  "expo": {
    "name": "Lumen: Daily Prayer & Bible",
    "slug": "lumen-daily-prayer",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "lumen",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "com.lumen.dailyprayer",
      "supportsTablet": false,
      "icon": "./assets/icon.png",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "package": "com.lumen.dailyprayer",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0E1220"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "fonts": [
            "./node_modules/@expo/vector-icons/build/vendor/react-native-vector-icons/Fonts/Ionicons.ttf",
            "./node_modules/@expo-google-fonts/fraunces/Fraunces_400Regular.ttf",
            "./node_modules/@expo-google-fonts/fraunces/Fraunces_600SemiBold.ttf",
            "./node_modules/@expo-google-fonts/figtree/Figtree_400Regular.ttf",
            "./node_modules/@expo-google-fonts/figtree/Figtree_500Medium.ttf",
            "./node_modules/@expo-google-fonts/figtree/Figtree_600SemiBold.ttf",
            "./node_modules/@expo-google-fonts/figtree/Figtree_700Bold.ttf"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/art/A17-splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#0E1220"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#D9A441"
        }
      ],
      "expo-asset",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
