{
  "name": "lumen-daily-prayer",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --import ./test/register.mjs --test \"src/**/*.test.ts\" \"scripts/*.test.mjs\"",
    "bible:pack": "node scripts/build-ebible-pack.mjs",
    "bible:pack:verify": "node --experimental-strip-types scripts/validate-ebible-source-pins.mjs",
    "application-content:build": "node --experimental-strip-types scripts/build-application-content-packs.mjs",
    "application-content:verify": "node --experimental-strip-types scripts/validate-application-content-packs.mjs",
    "application-content:verify:production": "node --experimental-strip-types scripts/validate-application-content-packs.mjs --production",
    "ui-locales:verify": "node --experimental-strip-types scripts/validate-ui-locales.mjs",
    "ui-locales:verify:production": "node --experimental-strip-types scripts/validate-ui-locales.mjs --production",
    "scripture:verify:integrity": "node scripts/verify-scripture-integrity.mjs",
    "scripture:verify:rights": "node scripts/verify-scripture-release-rights.mjs",
    "test:tz": "TZ=Europe/Berlin npm test && TZ=America/New_York npm test",
    "scripture:verify:ui": "node scripts/verify-scripture-ui-integrity.mjs",
    "release:verify:claims": "node scripts/verify-release-claims.mjs",
    "release:verify:bundle": "node scripts/verify-bundle-budget.mjs",
    "privacy:build": "node --experimental-strip-types scripts/build-privacy-page.mjs",
    "privacy:verify": "node --experimental-strip-types scripts/build-privacy-page.mjs --check"
  },
  "dependencies": {
    "@expo-google-fonts/figtree": "^0.2.3",
    "@expo-google-fonts/fraunces": "^0.2.3",
    "@expo/metro-runtime": "~56.0.21",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@sentry/react-native": "~7.11.0",
    "expo": "~56.0.0",
    "expo-asset": "~56.0.25",
    "expo-blur": "~56.0.4",
    "expo-build-properties": "~56.0.27",
    "expo-clipboard": "~56.0.4",
    "expo-constants": "~56.0.27",
    "expo-crypto": "~56.0.5",
    "expo-file-system": "~56.0.11",
    "expo-font": "~56.0.7",
    "expo-haptics": "~56.0.3",
    "expo-linear-gradient": "~56.0.4",
    "expo-linking": "~56.0.19",
    "expo-localization": "~56.0.6",
    "expo-notifications": "~56.0.26",
    "expo-router": "~56.2.22",
    "expo-secure-store": "~56.0.4",
    "expo-sharing": "~56.0.27",
    "expo-splash-screen": "~56.0.16",
    "expo-status-bar": "~56.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-purchases": "^9.15.3",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-view-shot": "5.1.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.8.3",
    "zustand": "^5.0.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "~19.2.10",
    "babel-preset-expo": "~56.0.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~56.0.4",
    "playwright-core": "^1.61.1",
    "typescript": "~6.0.3"
  },
  "private": true
}
